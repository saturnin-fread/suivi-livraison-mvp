# Modèle de configuration (copier en .env pour le développement local).
# En production, ces variables se règlent dans Railway, jamais dans le dépôt.
# Au démarrage, le serveur affiche ce qui est actif et signale ce qui manque
# (noms des variables seulement, jamais leurs valeurs).

PORT=3000
DATABASE_URL=postgresql://user:password@host:5432/delivery?sslmode=require
# Base URL publique de l'app (liens dans les e-mails, retour Google).
APP_BASE_URL=

# --- Secrets (aléatoires, distincts, 24 caractères minimum) --------------
# En leur absence, un repli interne est utilisé : à définir en production.
SESSION_SECRET=remplacer-par-un-secret-aleatoire-dedie
OTP_PEPPER=remplacer-par-un-autre-secret-aleatoire
MFA_SECRET=remplacer-par-un-secret-pour-la-double-authentification
# Coffre des liens de suivi : secrets d'au moins 32 octets.
TRACKING_TOKEN_SECRET=remplacer-par-un-secret-aleatoire-dedie
RATE_LIMIT_KEY_SECRET=remplacer-par-un-autre-secret-aleatoire
# Migration : commencer par dual, valider les liens existants, puis passer à encrypted_only.
TRACKING_TOKEN_STORAGE_MODE=dual

# --- Comptes amorcés au démarrage -----------------------------------------
# Compte propriétaire de l'entreprise de démonstration, utilisé sur /app/login
ADMIN_USER=proprietaire@example.com
ADMIN_PASSWORD=remplacer-par-un-mot-de-passe-fort
# Compte séparé réservé à l'administration de la plateforme sur /admin
PLATFORM_ADMIN_USER=plateforme@example.com
PLATFORM_ADMIN_PASSWORD=remplacer-par-un-autre-mot-de-passe-fort
# Adresses supplémentaires administratrices de la plateforme (virgules).
PLATFORM_ADMIN_EMAILS=
SUPPORT_EMAIL=support@gettraxo.app

# --- GPS (Traccar) ---------------------------------------------------------
# URL web publique de Traccar, sans slash final
TRACCAR_URL=https://traccar-production-1919.up.railway.app
TRACCAR_USER=admin@example.com
TRACCAR_PASSWORD=remplacer-par-le-mot-de-passe-traccar
# Identifiant du téléphone Traccar
TRACCAR_DEVICE_ID=61779795
# Itinéraire en direct : signal considéré comme perdu au-delà (secondes, défaut 180).
LIVE_ROUTE_STALE_SECONDS=

# --- Fonds cartographiques -------------------------------------------------
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors
MAP_TILE_MAX_ZOOM=19
MAP_SATELLITE_TILE_URL=
MAP_SATELLITE_ATTRIBUTION=
MAP_SATELLITE_MAX_ZOOM=19
MAP_DARK_TILE_URL=
MAP_ROADS_TILE_URL=
# Calque « libellés » du mode hybride de la carte (facultatif).
MAP_LABELS_TILE_URL=
MAP_LABELS_ATTRIBUTION=
MAP_LABELS_MAX_ZOOM=19
# Tuiles vectorielles auto-hébergées (service « tiles » interne).
TILES_INTERNAL_URL=

# --- Routage ---------------------------------------------------------------
# osrm pour activer, disabled sinon.
ROUTING_PROVIDER=disabled
ROUTING_OSRM_URL=
ROUTING_OSRM_PROFILE=driving
ROUTING_TIMEOUT_MS=5000
ROUTING_CACHE_TTL_MS=300000
ROUTING_MAX_ROUTE_COORDINATES=50
ROUTING_MAX_MATRIX_COORDINATES=25
ROUTING_MAP_DATA_VERSION=
ROUTING_PROVIDER_VERSION=

# --- Recherche de lieux ----------------------------------------------------
# nominatim (défaut) | photon | disabled
GEOCODER_PROVIDER=
GEOCODER_URL=
GEOCODER_COUNTRY=
GEOCODER_CONTACT=

# --- E-mail : l'envoi reste INACTIF tant que rien n'est configuré ----------
# Recommandé sur Railway (ports SMTP sortants bloqués) : l'API HTTP de Brevo
# passe par le port 443. Si BREVO_API_KEY est défini, il est utilisé EN
# PRIORITÉ. Clé à créer dans Brevo : SMTP & API → « API Keys ».
BREVO_API_KEY=
# Sinon, SMTP de n'importe quel fournisseur (Brevo, Amazon SES, Mailgun…) :
#   SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# SMTP_SECURE=true uniquement si le port est 465.
SMTP_SECURE=
# Alternative HTTP : Resend (utilisée seulement si ni Brevo ni SMTP).
RESEND_API_KEY=
# Expéditeur affiché (le domaine doit être vérifié chez le fournisseur).
EMAIL_FROM=TRAXO <notifications@gettraxo.app>
# on : code par e-mail à la connexion.
LOGIN_EMAIL_CODE=

# --- Connexion Google ------------------------------------------------------
# URI de redirection à déclarer chez Google : <APP_BASE_URL>/app/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- WhatsApp --------------------------------------------------------------
# off pour désactiver.
WHATSAPP_ENABLED=
WHATSAPP_SECRET=
WHATSAPP_MAX_PER_HOUR=

# --- Infrastructure --------------------------------------------------------
# Limitation d'abus partagée entre instances. Sans REDIS_URL, repli en mémoire.
REDIS_URL=
# off pour couper la purge automatique de la corbeille (30 jours).
TRASH_PURGE=
# Remises d'abonnement par cycle (par défaut : 0.05 trimestriel, 0.10 annuel).
BILLING_DISCOUNT_QUARTERLY=0.05
BILLING_DISCOUNT_YEARLY=0.10

# --- Paiement des recharges du portefeuille (Kkiapay) ----------------------
# Les trois clés activent le paiement en ligne (tableau de bord Kkiapay →
# Développeurs). À définir dans Railway uniquement, jamais dans le dépôt.
# Bac à sable par défaut ; KKIAPAY_SANDBOX=false pour encaisser réellement.
KKIAPAY_PUBLIC_KEY=
KKIAPAY_PRIVATE_KEY=
KKIAPAY_SECRET_KEY=
KKIAPAY_SANDBOX=true

# --- Démonstration locale uniquement (refusée sur Railway production) -----
DEMO_TRACKING_ENABLED=false
DEMO_TRACKING_TOKEN=remplacer-par-un-jeton-local-aleatoire

# --- Réservé aux tests (jamais en production) ------------------------------
# WHATSAPP_FAKE=outbox
# EMAIL_OUTBOX_DIR=
# TRASH_PURGE_START=
# Recharges acceptées sans paiement (développement et tests uniquement).
# BILLING_TEST_PAYMENTS=on
